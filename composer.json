{
  "name": "giogall1/php-mysql-smarty-blog",
  "description": "Simple PHP 8.1 blog application with MySQL, Smarty templates and Docker environment.",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "smarty/smarty": "^5.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "scripts": {
    "test": "phpunit"
  }
}
